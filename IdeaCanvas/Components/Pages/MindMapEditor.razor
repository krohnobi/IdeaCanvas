@page "/mindmap"
@using CommunityToolkit.Maui.Storage
@using IdeaCanvas.Interfaces
@using IdeaCanvas.Models

@inject IMindMapService MindMapService
@inject IMindMapStorageService StorageService

<MindMapToolbar Map="currentMap"
                CurveStrength="curveStrength"
                CurveStrengthChanged="OnCurveStrengthChanged"
                OnCreate="CreateMap"
                OnSave="SaveMap"
                OnLoad="LoadMap"
                OnExportPdf="HandleExportRequested"
                OnUnpinAll="HandleUnpinAllRequested"
                OnResetZoom="HandleZoomResetRequested" />

<MindMapCanvas @ref="canvasRef" Map="currentMap" CurveStrength="curveStrength" />
<NewMapDialog @bind-Visible="showNewMapDialog" OnConfirm="HandleNewMapConfirmed" />


@code {
    private MindMap? currentMap;
    private double curveStrength = 0;
    private MindMapCanvas? canvasRef;



    private bool showNewMapDialog;

    private void CreateMap()
    {
        showNewMapDialog = true; // öffnet nur den Dialog
    }

    private void HandleNewMapConfirmed((string Title, string Topic) result)
    {
        currentMap = StorageService.CreateMap(result.Title);
        MindMapService.AddNode(currentMap, null, string.IsNullOrWhiteSpace(result.Topic) ? result.Title : result.Topic);
        // Layout übernimmt MindMapCanvas selbst, sobald es die neue Map als Parameter bekommt
    }

    private async Task OnCurveStrengthChanged(double value)
    {
        curveStrength = value;
        if (canvasRef != null)
            await canvasRef.ApplyLayout();
    }

    private async Task SaveMap()
    {
        try
        {
            if (currentMap == null)
                throw new InvalidOperationException("Keine MindMap gefunden.");

            string json = StorageService.SerializeMap(currentMap);
            using var stream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(json));

            var result = await FileSaver.Default.SaveAsync(
                $"{currentMap.Title}.json", stream, CancellationToken.None);

            if (!result.IsSuccessful)
                return; // Nutzer hat abgebrochen

            if (Application.Current?.MainPage != null)
            {
                await Application.Current.MainPage.DisplayAlertAsync(
                    "Erfolg", $"Erfolgreich gespeichert unter:\n{result.FilePath}", "OK");
            }
        }
        catch (Exception ex)
        {
            if (Application.Current?.MainPage != null)
            {
                await Application.Current.MainPage.DisplayAlertAsync(
                    "Fehler", $"Fehler beim Speichern: {ex.Message}", "Schließen");
            }
        }
    }

    private async Task LoadMap()
    {
        try
        {
            var fileResult = await FilePicker.Default.PickAsync();

            if (fileResult == null)
                return; // abgebrochen, kein Fehler

            currentMap = await StorageService.LoadAsync(fileResult.FullPath);

            if (currentMap == null)
            {
                throw new Exception("Laden fehlgeschlagen.");
            }
        }
        catch (Exception ex)
        {
            if (Application.Current?.MainPage != null)
            {
                await Application.Current.MainPage.DisplayAlertAsync(
                    "Fehler",
                    $"Fehler beim Laden: {ex.Message}",
                    "Schließen"
                );
            }
        }
    }

    private async Task HandleExportRequested()
    {
        if (canvasRef != null)
            await canvasRef.ExportPdf();
    }

    private async Task HandleUnpinAllRequested()
    {
        if (currentMap == null || canvasRef == null) return;

        MindMapService.UnpinAllNodes(currentMap);
        await canvasRef.ApplyLayout();
    }

    private void HandleZoomResetRequested()
    {
        if (canvasRef != null)
        {
            canvasRef.CenterOnRoot();
        }
        
    }
}