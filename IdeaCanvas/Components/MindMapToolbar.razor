@* MindMapToolbar.razor *@
@using IdeaCanvas.Models

<div class="toolbar">
    <button class="primary" @onclick="OnNewMapRequested">Neue MindMap erstellen</button>
    <button @onclick="OnLoadClicked">Load Map</button>
    @if (Map != null)
    {
        <div class="divider"></div>
        <div class="curve-control">
            <label>Curve Strength: @CurveStrength</label>
            <input type="range" min="-0.3" max="0.3" step="0.1"
                   value="@CurveStrength"
                   @oninput="OnCurveStrengthChanged" />
        </div>
        <div class="divider"></div>
        <button @onclick="OnSaveClicked">Save Map</button>
        <button @onclick="OnExportPdfClicked">Export als PDF</button>
        <div class="divider"></div>
        <button @onclick="OnUnpinAllClicked">Alle Pins lösen</button>
        <button @onclick="OnResetZoomClicked">Zoom zurücksetzen</button>
    }
</div>

@code {
    [Parameter] public MindMap? Map { get; set; }
    [Parameter] public double CurveStrength { get; set; }
    [Parameter] public EventCallback<double> CurveStrengthChanged { get; set; }

    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnLoad { get; set; }
    [Parameter] public EventCallback OnExportPdf { get; set; }
    [Parameter] public EventCallback OnUnpinAll { get; set; }
    [Parameter] public EventCallback OnResetZoom { get; set; }

    private Task OnNewMapRequested() => OnCreate.InvokeAsync();
    private Task OnSaveClicked() => OnSave.InvokeAsync();
    private Task OnLoadClicked() => OnLoad.InvokeAsync();
    private Task OnExportPdfClicked() => OnExportPdf.InvokeAsync();
    private Task OnUnpinAllClicked() => OnUnpinAll.InvokeAsync();
    private Task OnResetZoomClicked() => OnResetZoom.InvokeAsync();

    private Task OnCurveStrengthChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double value))
        {
            return CurveStrengthChanged.InvokeAsync(value);
        }
        return Task.CompletedTask;
    }
}