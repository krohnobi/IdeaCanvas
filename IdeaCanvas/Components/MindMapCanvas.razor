@using IdeaCanvas.Enums
@using IdeaCanvas.Interfaces
@using IdeaCanvas.Models
@inject IMindMapLayoutService LayoutService


<div class="mindmap-canvas">
    <div class="mindmap-viewport">

        <svg class="mindmap-connections">

            @foreach (var connection in GetConnections(MindMap.RootNode))
            {
                if (nodeLayouts.TryGetValue(connection.Parent.Id, out NodeLayout? parentLayout) &&
                    nodeLayouts.TryGetValue(connection.Child.Id, out NodeLayout? childLayout))
                {
                    <line x1="@parentLayout.X"
                          y1="@parentLayout.Y"
                          x2="@childLayout.X"
                          y2="@childLayout.Y"
                          stroke="#555"
                          stroke-width="2" />
                }
            }

        </svg>
        @if (MindMap.RootNode != null)
        {
            @foreach (MindMapNode node in GetAllNodes(MindMap.RootNode))
            {
                if (nodeLayouts.TryGetValue(node.Id, out NodeLayout? layout))
                {
                    <div class="positioned-node"
                         style="left: @(layout.X)px;
                        top: @(layout.Y)px;">
                        <MindMapNodeView Node="@node" />
                    </div>
                }
            }
        }
    </div>

</div>

