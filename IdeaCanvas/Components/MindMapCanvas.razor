    private IEnumerable<MindMapNode> GetAllNodes(MindMapNode node)
    {
        yield return node;

        foreach (MindMapNode child in node.Children)
        {
            foreach (MindMapNode descendant in GetAllNodes(child))
            {
                yield return descendant;
            }
        }
    }

    private IReadOnlyDictionary<Guid, NodeLayout> nodeLayouts =
        new Dictionary<Guid, NodeLayout>();

    protected override async Task OnInitializedAsync()
    {
        nodeLayouts = await LayoutService.CalculateLayoutAsync(MindMap);
    }

    private List<(MindMapNode Parent, MindMapNode Child)> GetConnections(MindMapNode node)
    {
        List<(MindMapNode, MindMapNode)> connectionList = new();

        foreach (MindMapNode child in node.Children)
        {
            connectionList.Add((node, child));
            connectionList.AddRange(GetConnections(child));
        }
        return connectionList;
    }
